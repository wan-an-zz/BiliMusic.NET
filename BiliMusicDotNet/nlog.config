<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwConfigExceptions="true">

  <!-- 日志目录：默认 LocalApplicationData/BiliMusicDotNet/logs（各平台均为应用可写目录），
       可用环境变量 BILIMUSICDOTNET_LOG_DIR 覆盖（容器 / CI / 临时排查时无需改文件）。 -->
  <variable name="logDir" value="${environment:variable=BILIMUSICDOTNET_LOG_DIR:whenEmpty=${specialfolder:folder=LocalApplicationData}/BiliMusicDotNet/logs}" />

  <!-- 最低级别：默认 Info；调试时可用 BILIMUSICDOTNET_LOG_LEVEL=Debug 临时放开，无需重新编译。 -->
  <variable name="minLevel" value="${environment:variable=BILIMUSICDOTNET_LOG_LEVEL:whenEmpty=Info}" />

  <!-- 统一布局：时间|级别|线程|logger|消息|异常，文件与控制台共用。 -->
  <variable name="layout" value="${longdate}|${level:uppercase=true}|${threadid:padding=3}|${logger}|${message}${exception:format=tostring}" />

  <targets>
    <!-- 应用日志：按天分文件，单文件超过 10 MB 自动归档，最多保留 5 个归档。 -->
    <target xsi:type="File" name="file"
            fileName="${logDir}/bilimusicdotnet-${shortdate}.log"
            layout="${layout}"
            archiveAboveSize="10485760"
            maxArchiveFiles="5"
            archiveNumbering="Sequence" />

    <!-- 控制台：便于 CI、容器与移动端 logcat 直接观察。 -->
    <target xsi:type="Console" name="console" layout="${layout}" />
  </targets>

  <rules>
    <!-- 级别过滤统一由本文件决定：代码侧不再重复配置，避免两处规则互相掩盖。 -->
    <logger name="*" minlevel="${minLevel}" writeTo="file,console" />
  </rules>
</nlog>
