<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BiliMusicDotNet.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <!-- 视图定位器由 App 启动时从容器取得并挂到 DataTemplates，见 App.axaml.cs。 -->

    <Application.Styles>
        <FluentTheme />
        <!--
            此处原先还有 SukiUI 的 SukiTheme。它会给全应用的 Button 装上带按压物理动画的控件主题，
            而该动画在按钮脱离可视树后仍会订阅渲染帧，抛 InvalidOperationException 直接崩进程。
            桌面窗口已改为普通 Window，不再使用任何 SukiUI 控件，故移除。
        -->
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 导航图标路径数据，两端导航控件共用。 -->
                <MergeResourceInclude Source="avares://BiliMusicDotNet/Styles/Icons.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
