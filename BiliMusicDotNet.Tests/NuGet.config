<?xml version="1.0" encoding="utf-8"?>
<!--
  本机（离线）还原配置。

  当前开发环境的 nuget.org 不可达（TLS 被拦截），因此本目录自带一份只指向本地源的配置：
  1. `.nuget-offline-feed/`：由本机 NuGet 缓存（%USERPROFILE%\.nuget\packages）中的 .nupkg 汇集而成；
  2. `global-packages`：直接指向同一份缓存目录本身（`$(NuGetPackageRoot)`，由 NuGet 在还原时提供）。
     离线源是"逐个包挑出来归档"的，钉住新版本后往往缺少对应包；
     缓存目录是 NuGet 自己的还原产物，凡是本机装过的版本都在，用它兜住这类缺口。
  这样还原无需联网，CI 与联网环境不会受本文件影响。

  联网环境下如需改用官方源：删除本文件，或把下面的 clear 与两个本地源去掉即可。
-->
<configuration>
  <packageSources>
    <clear />
    <add key="local-offline" value=".nuget-offline-feed" />
    <add key="global-packages" value="$(NuGetPackageRoot)" />
  </packageSources>
</configuration>
