<Project>
  <!-- https://learn.microsoft.com/en-us/nuget/consume-packages/central-package-management -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Avalonia packages -->
    <!-- Important: keep version in sync! -->
    <PackageVersion Include="Avalonia" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Headless" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Headless.XUnit" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageVersion Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageVersion Include="Avalonia.iOS" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Browser" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Android" Version="12.1.4" />
    <PackageVersion Include="CherylUI" Version="2.1.0" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="Microsoft.DotNet.HotReload.WebAssembly.Browser" Version="11.0.100-preview.1.26104.118" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0-rc.1.26425.128" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="11.0.0-preview.6.26359.118" />
    <PackageVersion Include="NLog" Version="6.2.0" />
    <PackageVersion Include="NLog.Extensions.Logging" Version="6.2.0" />
    <PackageVersion Include="SukiUI" Version="7.0.2-nightly20260925.468" />
    <PackageVersion Include="Xamarin.AndroidX.Core.SplashScreen" Version="1.2.0.2" />
    <!-- 二维码渲染（真机验证探针用；只取 AsciiQRCode 渲染器，不碰依赖 System.Drawing 的那几个）。 -->
    <PackageVersion Include="QRCoder" Version="1.8.0" />
    <!--
      测试栈。选型对齐本机 NuGet 缓存中已有的版本，保证离线环境也能还原。
      用 xunit.v3 而非 xunit 2.x：v3 自带 Microsoft.Testing.Platform 运行器，
      不需要 VSTest 的 testhost 子进程（本机沙箱下该子进程无法启动）。
      版本必须钉在 3.2.2：Avalonia.Headless.XUnit 是针对它编译的，4.x 预发布改过
      发现阶段的 TestIntrospectionHelper 签名，加载即 MissingMethodException。
    -->
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <!-- 测试项目直接引用被测服务用到的日志抽象（版本与上面的 Microsoft.Extensions.Logging 保持一致）。 -->
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0-preview.6.26359.118" />
  </ItemGroup>
</Project>