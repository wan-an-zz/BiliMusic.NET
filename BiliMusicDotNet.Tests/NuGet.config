<?xml version="1.0" encoding="utf-8"?>
<!--
  本机（离线）还原配置。

  当前开发环境的 nuget.org 不可达（TLS 被拦截），因此本目录自带一份只指向本地离线源的配置：
  `.nuget-offline-feed/` 由本机 NuGet 缓存（%USERPROFILE%\.nuget\packages）中的 .nupkg 汇集而成。
  这样 `dotnet test` 无需联网即可还原，CI 与联网环境不会受本文件影响。

  联网环境下如需改用官方源：删除本文件，或把下面的 clear 与本地源去掉即可。
-->
<configuration>
  <packageSources>
    <clear />
    <add key="local-offline" value=".nuget-offline-feed" />
  </packageSources>
</configuration>
