<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <!-- System / System.Collections.Generic / System.Linq / System.Threading.Tasks / System.Net.Http 等基础命名空间。 -->
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>

        <!-- 测试即质量闸门：分析器告警按错误处理（含 xUnit 分析器），不允许"带警告通过"。 -->
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

        <OutputType>Exe</OutputType>
        <!-- xunit.v3 要求测试项目产出可执行宿主（apphost）。 -->
        <UseAppHost>true</UseAppHost>

        <!-- 本机沙箱里 Avalonia 的遥测任务无法写 user profile 目录，统一用这个开关关闭它。 -->
        <UsedAvaloniaProducts></UsedAvaloniaProducts>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" />
        <PackageReference Include="Avalonia.Headless" />
        <PackageReference Include="Avalonia.Headless.XUnit" />
        <PackageReference Include="CommunityToolkit.Mvvm" />
        <PackageReference Include="xunit.v3"/>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"/>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection"/>
    </ItemGroup>

    <!--
      直接引用被测项目：测试从此享有"被测代码重构即变红"的完整保护，
      也让 ViewModel / 视图可用 [AvaloniaFact] 在 Headless 平台上真实跑起来。

      曾因 Avalonia.BuildServices 遥测任务写 %LOCALAPPDATA% 失败而改用"链接源码"，
      现已用 <UsedAvaloniaProducts></UsedAvaloniaProducts>（项目级）+ AVALONIA_TELEMETRY_OPTOUT 关掉该任务。
    -->
    <ItemGroup>
        <ProjectReference Include="..\BiliMusicDotNet\BiliMusicDotNet.csproj" />
    </ItemGroup>
</Project>
