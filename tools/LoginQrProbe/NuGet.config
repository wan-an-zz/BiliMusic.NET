<?xml version="1.0" encoding="utf-8"?>
<!--
  本机（离线）还原配置，与 BiliMusicDotNet.Tests 同一套做法：
  把 %USERPROFILE%\.nuget\packages 里已缓存的 .nupkg 汇集成仓库内的本地源。
  联网环境删掉本文件即改走官方源。
-->
<configuration>
  <packageSources>
    <clear />
    <add key="local-offline" value=".nuget-offline-feed" />
  </packageSources>
</configuration>
