<?xml version="1.0" encoding="utf-8"?>
<!--
  还原源配置：本地离线包源在前，官方源兜底。

  本地离线源 `.nuget-offline-feed/` 由本机 NuGet 缓存（%USERPROFILE%\.nuget\packages）汇集而成，
  用于无网络环境（该目录已被 .gitignore 忽略）。联网环境会自然落到 nuget.org 去取未缓存的包
  （例如 QRCoder），不需要改配置。

  纯离线且缓存里没有 QRCoder 时还原会失败——联网还原一次即可（包进入缓存后又能离线用）。
-->
<configuration>
  <packageSources>
    <clear />
    <add key="local-offline" value=".nuget-offline-feed" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
