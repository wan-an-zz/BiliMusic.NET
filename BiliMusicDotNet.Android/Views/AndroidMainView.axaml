<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BiliMusicDotNet.ViewModels;assembly=BiliMusicDotNet"
             xmlns:ac="clr-namespace:BiliMusicDotNet.Android.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="vm:MainViewModel"
             x:Class="BiliMusicDotNet.Android.Views.AndroidMainView">
    
    <ac:BottomNavControl ItemsResource="{Binding AllViews}"/>
    
</UserControl>
