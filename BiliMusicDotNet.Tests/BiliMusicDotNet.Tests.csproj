<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <!-- System / System.Collections.Generic / System.Linq / System.Threading.Tasks / System.Net.Http 等基础命名空间。 -->
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>

        <!-- 测试即质量闸门：分析器告警按错误处理（含 xUnit 分析器），不允许"带警告通过"。 -->
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

        <OutputType>Exe</OutputType>
        <!-- xunit.v3 要求测试项目产出可执行宿主（apphost）。 -->
        <UseAppHost>true</UseAppHost>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" />
        <PackageReference Include="Avalonia.Headless" />
        <PackageReference Include="Avalonia.Headless.XUnit" />
        <PackageReference Include="CommunityToolkit.Mvvm" />
        <PackageReference Include="xunit.v3"/>
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions"/>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection"/>
        <PackageReference Include="System.Security.Cryptography.ProtectedData"/>
    </ItemGroup>

    <!--
      直接引用被测项目：测试从此享有"被测代码重构即变红"的完整保护，
      也让 ViewModel / 视图可用 [AvaloniaFact] 在 Headless 平台上真实跑起来。

      曾因 Avalonia.BuildServices 遥测任务写 %LOCALAPPDATA% 失败而改用"链接源码"。
      该任务只能由构建命令行上的 -p:UsedAvaloniaProducts="" 关闭：写在项目文件里无效，
      Avalonia.props 会把 ;AvaloniaUI 无条件追加进这个属性（见 AGENTS.md）。
    -->
    <ItemGroup>
        <ProjectReference Include="..\BiliMusicDotNet\BiliMusicDotNet.csproj" />
    </ItemGroup>

    <!--
      链接而不是引用桌面端项目：那边是带入口点的 WinExe 应用头，
      为测一个加密类把整个桌面端（Avalonia.Desktop / SukiUI / NLog）拖进来不划算。
      链接的仍是同一份源码，桌面端改了这里就会跟着变。
    -->
    <ItemGroup>
        <Compile Include="..\BiliMusicDotNet.Desktop\Services\DpapiEncryptService.cs"
                 Link="Linked\DpapiEncryptService.cs" />
    </ItemGroup>
</Project>
