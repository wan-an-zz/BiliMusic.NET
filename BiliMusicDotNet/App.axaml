<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BiliMusicDotNet.App"
             xmlns:sukiUi="clr-namespace:SukiUI;assembly=SukiUI"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <!-- 视图定位器由 App 启动时从容器取得并挂到 DataTemplates，见 App.axaml.cs。 -->

    <Application.Styles>
        <FluentTheme />
        <sukiUi:SukiTheme ThemeColor="Blue" Locale="zh-CN"/>
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 导航图标路径数据，两端导航控件共用。 -->
                <MergeResourceInclude Source="avares://BiliMusicDotNet/Styles/Icons.axaml"/>
            </ResourceDictionary.MergedDictionaries>

        <!-- SukiUI 用 DefaultFontFamily、Fluent 用 ContentControlThemeFontFamily，两处都要覆盖才能全局生效；
             字体集合在 AppBuilderFontExtensions 里注册，Inter 与 $Default 只作缺字兜底。 -->
        <FontFamily x:Key="DefaultFontFamily">fonts:HarmonyOsSans#HarmonyOS Sans SC, fonts:Inter#Inter, $Default</FontFamily>
        <FontFamily x:Key="ContentControlThemeFontFamily">fonts:HarmonyOsSans#HarmonyOS Sans SC, fonts:Inter#Inter, $Default</FontFamily>
    </ResourceDictionary>
    </Application.Resources>
</Application>
